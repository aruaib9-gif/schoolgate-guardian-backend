# ---------------------------------------------------------------------------
# SchoolGate Guardian backend — environment configuration
# Copy to .env and fill in real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schoolgate?schema=public"

# HTTP server
PORT=4000
# Comma-separated list of allowed CORS origins (the frontend URLs). Use * for any.
CORS_ORIGIN="http://localhost:5173"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# File uploads
UPLOAD_DIR="./uploads"
# Public base URL used to build returned file URLs (usually your API's own origin)
PUBLIC_URL="http://localhost:4000"
MAX_UPLOAD_MB=10

# Email (nodemailer SMTP). If unset, emails are logged to the console instead of sent.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="SchoolGate Guardian <no-reply@schoolgate.example>"

# Allow open self-registration at POST /auth/register. Defaults: on in dev,
# OFF in production (accounts are then created via invites/superadmin only).
# The very first account in an empty database is always allowed (bootstrap).
ALLOW_SELF_SIGNUP=""

# Seed superadmin (used by `npm run seed`)
SEED_SUPERADMIN_EMAIL="superadmin@schoolgate.example"
SEED_SUPERADMIN_PASSWORD="ChangeMe123!"
# Password given to the seeded school-admin logins (used by the web app / mobile).
SEED_SCHOOL_ADMIN_PASSWORD="password123"

# Shared secret that lets the scheduler / cron hit /functions/* without a user JWT.
# Send it as header:  x-cron-secret: <value>
CRON_SECRET="change-me-cron-secret"

# --- Email delivery -------------------------------------------------------
# Provider: resend | smtp | console. Leave blank to auto-detect (Resend if a
# key is present, else SMTP if a host is set, else log to the console).
EMAIL_PROVIDER=""
# Resend API key (https://resend.com → API Keys). The FROM domain must be
# verified in Resend or sends will be rejected.
RESEND_API_KEY=""
# Where emailed links point — your WEB APP, not the API.
APP_URL="http://localhost:5173"
# Lifetime of set-password / reset links.
INVITE_TTL_DAYS=7
RESET_TTL_HOURS=2
